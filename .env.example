# ===============================================================
# CONFIGURAÇÕES DO BOT DE OFERTAS (MERCADO LIVRE & SHOPEE)
# ===============================================================

# 1. TELEGRAM
# Obtenha seu token conversando com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui

# Seu ID de usuário ou ID do grupo/canal no Telegram
# Se você não souber seu Chat ID, execute o bot e envie /start para ele no Telegram.
# Ele responderá com o seu Chat ID exato!
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# 2. INTERVALO E FILTROS DE OFERTAS
# Intervalo de verificação automática em minutos (ex: 30)
CHECK_INTERVAL_MINUTES=30

# Desconto mínimo exigido para enviar a oferta (% OFF)
MIN_DISCOUNT_PERCENT=15

# Quantidade máxima de ofertas enviadas por varredura (evita spam)
MAX_DEALS_PER_RUN=5

# 3. AFILIADOS MERCADO LIVRE
# Se você tiver a tag ou parâmetros de afiliado do ML, insira aqui.
# Exemplo: matt_tool=12345678&matt_word=promo
ML_AFFILIATE_TAG=

# Ou template de link personalizado (deixe em branco se não usar):
# ML_AFFILIATE_URL_TEMPLATE={url}?{tag}

# Categorias do Mercado Livre para monitorar (separadas por vírgula):
ML_CATEGORIES=tecnologia,eletrodomesticos,casa-e-decoracao,beleza-e-cuidado-pessoal,ferramentas,mais-vendidos

# 4. AFILIADOS SHOPEE
# Opção A: SubID ou Tag padrão para anexar aos links
SHOPEE_AFFILIATE_TAG=sub_id=telegram

# Opção B: Chaves da API Oficial de Afiliados Shopee (Opcional - gera shortlinks s.shopee automaticamente)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Opção C: Universal Link personalizado (deixe em branco se não usar)
SHOPEE_UNIVERSAL_LINK=
